# Пароль к базе. В проде обязательно свой — значения по умолчанию из
# docker-compose.yml годятся только для локального запуска.
POSTGRES_USER=swap
POSTGRES_PASSWORD=swap
POSTGRES_DB=swap

# На каком адресе и порту слушает API. Наружу его отдаёт обратный прокси,
# поэтому по умолчанию только localhost.
API_BIND=127.0.0.1
API_PORT=8000

# Рубильник биржи. false — сервис не принимает регистраций и заказов, а
# расширение по /api/v1/status понимает это и не рисует кнопки.
# Применяется перезапуском: docker compose up -d
SWAP_ENABLED=true
# Что показать студенту вместо меню. Пусто — текст по умолчанию из config.py.
SWAP_DISABLED_MESSAGE=

MATCH_INTERVAL_SECONDS=30
MAX_OPEN_ORDERS_PER_STUDENT=20
LOG_LEVEL=INFO
